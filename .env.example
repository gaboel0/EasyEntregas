# Fonte de dados do painel: "local" (demonstração, localStorage) ou "http" (API real)
VITE_DATA_SOURCE=local
# URL base da API quando VITE_DATA_SOURCE=http. Nunca coloque segredos em variáveis VITE_*:
# elas são embutidas no bundle e ficam visíveis no navegador.
VITE_API_BASE_URL=https://api.exemplo.com.br/v1
